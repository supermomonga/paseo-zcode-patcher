+++ b/packages/server/src/server/agent/providers/zcode/agent.test.ts
@@ -0,0 +1,580 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { z } from "zod";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { ZCodeAgentSession } from "./agent.js";
+import type { HostBridge, HostSubscription } from "./host/bridge.js";
+import type { Logger } from "./logger.js";
+import type {
+  DynamicEvent,
+  SessionSnapshot,
+} from "./protocol/v1/host-schemas.js";
+
+const temporaryDirectories: string[] = [];
+
+function snapshot(workspace: string): SessionSnapshot {
+  return {
+    session: {
+      sessionId: "session-1",
+      status: "idle",
+      workspace: { workspacePath: workspace },
+      title: "Session",
+      updatedAt: 1,
+    },
+    settings: {
+      model: {
+        current: { providerId: "provider", modelId: "model" },
+        available: [
+          {
+            ref: { providerId: "provider", modelId: "model" },
+            label: "Model",
+            providerLabel: "Provider",
+          },
+        ],
+      },
+      thoughtLevel: {
+        enabled: true,
+        current: "high",
+        available: [{ value: "high", label: "High" }],
+      },
+      mode: { current: "plan" },
+    },
+    messages: [],
+    runtime: {},
+    todos: [],
+    slashCommands: [
+      { name: "review", description: "Review", inputHint: "<path>" },
+    ],
+  };
+}
+
+class FakeBridge implements HostBridge {
+  readonly calls: Array<{ method: string; params: unknown }> = [];
+  private handler: ((event: DynamicEvent) => Promise<void> | void) | undefined;
+
+  constructor(private current: SessionSnapshot) {}
+
+  async request<Schema extends z.ZodType>(
+    method: string,
+    params: unknown,
+    resultSchema: Schema
+  ): Promise<z.output<Schema>> {
+    this.calls.push({ method, params });
+    let result: unknown = null;
+    if (method === "sendPrompt") {
+      result = { sessionId: "session-1", accepted: true };
+    } else if (method === "getTaskTokenUsage") {
+      result = {
+        sessionId: "session-1",
+        totalTokens: 12,
+        inputTokens: 5,
+        outputTokens: 7,
+        reasoningTokens: 2,
+        cacheCreationTokens: 0,
+        cacheReadTokens: 1,
+      };
+    } else if (method === "setMode") {
+      const value = params as { mode: string };
+      this.current = {
+        ...this.current,
+        settings: {
+          ...this.current.settings,
+          mode: { current: value.mode },
+        },
+      };
+      result = this.current;
+    } else if (method === "setModel" || method === "setThoughtLevel") {
+      result = this.current;
+    }
+    return resultSchema.parse(result);
+  }
+
+  async subscribe(
+    _target: {
+      workspacePath: string;
+      sessionId: string;
+      deliveryKind: "desktop-continuous";
+      includeSnapshot: boolean;
+    },
+    handler: (event: DynamicEvent) => Promise<void> | void
+  ): Promise<HostSubscription> {
+    this.calls.push({ method: "subscribe", params: null });
+    this.handler = handler;
+    return {
+      dispose: async () => {
+        this.calls.push({ method: "unsubscribe", params: null });
+        this.handler = undefined;
+      },
+    };
+  }
+
+  async close(): Promise<void> {}
+
+  async emit(event: DynamicEvent): Promise<void> {
+    if (this.handler === undefined) throw new Error("not subscribed");
+    await this.handler(event);
+  }
+}
+
+const logger: Logger = {
+  log: vi.fn(),
+  error: vi.fn(),
+};
+
+async function fixture() {
+  const workspace = await mkdtemp(join(tmpdir(), "paseo-zcode-session-"));
+  temporaryDirectories.push(workspace);
+  const initial = snapshot(workspace);
+  const bridge = new FakeBridge(initial);
+  const session = await ZCodeAgentSession.create({
+    bridge,
+    logger,
+    workspace,
+    snapshot: initial,
+    onClose: () => undefined,
+  });
+  return { workspace, bridge, session, initial };
+}
+
+afterEach(async () => {
+  await Promise.all(
+    temporaryDirectories
+      .splice(0)
+      .map((directory) => rm(directory, { recursive: true, force: true }))
+  );
+  vi.clearAllMocks();
+});
+
+describe("ZCode native session", () => {
+  it("subscribes before sending and maps streaming, tools, usage, and todo", async () => {
+    const { bridge, session, initial } = await fixture();
+    const events: unknown[] = [];
+    session.subscribe((event) => events.push(event));
+    const run = session.run("hello");
+    await vi.waitFor(() =>
+      expect(bridge.calls.some((call) => call.method === "sendPrompt")).toBe(
+        true
+      )
+    );
+    expect(bridge.calls.map((call) => call.method).slice(0, 2)).toEqual([
+      "subscribe",
+      "sendPrompt",
+    ]);
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e0",
+        sessionId: "session-1",
+        turnId: "native-turn",
+        seq: 0,
+        timestamp: 1,
+        deliveryKind: "desktop-continuous",
+        type: "model.streaming",
+        payload: {
+          kind: "text_delta",
+          delta: "answer",
+          assistantMessageId: "assistant-1",
+        },
+      },
+    });
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e1",
+        sessionId: "session-1",
+        turnId: "native-turn",
+        seq: 1,
+        timestamp: 2,
+        deliveryKind: "desktop-continuous",
+        type: "tool.updated",
+        payload: {
+          kind: "started",
+          toolCallId: "tool-1",
+          toolName: "Read",
+          input: { path: "README.md" },
+        },
+      },
+    });
+    await bridge.emit({
+      type: "snapshot",
+      snapshot: {
+        ...initial,
+        todos: [
+          { content: "Implement", status: "in_progress", priority: "high" },
+        ],
+      },
+    });
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e2",
+        sessionId: "session-1",
+        turnId: "native-turn",
+        seq: 2,
+        timestamp: 3,
+        deliveryKind: "desktop-continuous",
+        type: "tool.updated",
+        payload: {
+          kind: "result",
+          toolCallId: "tool-1",
+          toolName: "Read",
+          result: "ok",
+        },
+      },
+    });
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e3",
+        sessionId: "session-1",
+        turnId: "native-turn",
+        seq: 3,
+        timestamp: 4,
+        deliveryKind: "desktop-continuous",
+        type: "turn.completed",
+        payload: { resultType: "success" },
+      },
+    });
+    await expect(run).resolves.toMatchObject({
+      sessionId: "session-1",
+      finalText: "answer",
+      usage: { inputTokens: 5, outputTokens: 7, cachedInputTokens: 1 },
+    });
+    expect(events).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          type: "timeline",
+          item: expect.objectContaining({
+            type: "assistant_message",
+            text: "answer",
+          }),
+        }),
+        expect.objectContaining({
+          type: "timeline",
+          item: expect.objectContaining({
+            type: "todo",
+            items: [
+              expect.objectContaining({
+                text: "Implement",
+                status: "in_progress",
+                priority: "high",
+              }),
+            ],
+          }),
+        }),
+        expect.objectContaining({ type: "turn_completed" }),
+      ])
+    );
+  });
+
+  it("rejects a second prompt instead of queueing it", async () => {
+    const { bridge, session } = await fixture();
+    const first = session.run("first");
+    await vi.waitFor(() =>
+      expect(bridge.calls.some((call) => call.method === "sendPrompt")).toBe(
+        true
+      )
+    );
+    await expect(session.run("second")).rejects.toThrow(/active turn/u);
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e0",
+        sessionId: "session-1",
+        seq: 0,
+        timestamp: 1,
+        deliveryKind: "desktop-continuous",
+        type: "turn.completed",
+        payload: { resultType: "success" },
+      },
+    });
+    await first;
+  });
+
+  it("publishes plan and todo independently and responds exactly once", async () => {
+    const { bridge, session, initial } = await fixture();
+    const events: unknown[] = [];
+    session.subscribe((event) => events.push(event));
+    const run = session.run("plan");
+    await vi.waitFor(() =>
+      expect(bridge.calls.some((call) => call.method === "sendPrompt")).toBe(
+        true
+      )
+    );
+    await bridge.emit({
+      type: "snapshot",
+      snapshot: {
+        ...initial,
+        todos: [
+          { content: "Separate todo", status: "pending", priority: "medium" },
+        ],
+      },
+    });
+    await bridge.emit({
+      type: "permission.request",
+      request: {
+        requestId: "plan-request",
+        sessionId: "session-1",
+        turnId: "native-turn",
+        toolCallId: "exit-plan",
+        toolName: "ExitPlanMode",
+        reason: "Review the plan",
+        riskLevel: "medium",
+        input: { plan: "# Native plan\n\n- Step" },
+        options: [
+          {
+            optionId: "approve-native",
+            kind: "allow_once",
+            name: "Approve",
+            response: { decision: "allow" },
+          },
+          {
+            optionId: "dismiss-native",
+            kind: "deny_once",
+            name: "Dismiss",
+            response: { decision: "deny" },
+          },
+        ],
+      },
+    });
+    const pending = session.getPendingPermissions()[0]!;
+    expect(pending).toMatchObject({
+      id: "zcode-plan:plan-request",
+      kind: "plan",
+      input: { plan: "# Native plan\n\n- Step" },
+      metadata: {
+        planText: "# Native plan\n\n- Step",
+        source: "zcode_plan_approval",
+      },
+    });
+    expect(pending).not.toHaveProperty("metadata.requestId");
+    await session.respondToPermission(pending.id, {
+      behavior: "allow",
+      selectedActionId: "approve-native",
+    });
+    expect(
+      bridge.calls.filter((call) => call.method === "respondPermission")
+    ).toEqual([
+      {
+        method: "respondPermission",
+        params: {
+          workspacePath: expect.any(String),
+          sessionId: "session-1",
+          requestId: "plan-request",
+          optionId: "approve-native",
+        },
+      },
+    ]);
+    await expect(
+      session.respondToPermission(pending.id, {
+        behavior: "allow",
+        selectedActionId: "approve-native",
+      })
+    ).rejects.toThrow(/Unknown ZCode interaction/u);
+    expect(
+      events.filter(
+        (event) =>
+          typeof event === "object" &&
+          event !== null &&
+          "type" in event &&
+          event.type === "timeline"
+      )
+    ).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          item: expect.objectContaining({
+            type: "todo",
+            items: [expect.objectContaining({ text: "Separate todo" })],
+          }),
+        }),
+      ])
+    );
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e0",
+        sessionId: "session-1",
+        turnId: "native-turn",
+        seq: 0,
+        timestamp: 2,
+        deliveryKind: "desktop-continuous",
+        type: "turn.completed",
+        payload: { resultType: "success" },
+      },
+    });
+    await run;
+  });
+
+  it("maps question labels back to native values", async () => {
+    const { bridge, session } = await fixture();
+    const run = session.run("ask");
+    await vi.waitFor(() =>
+      expect(bridge.calls.some((call) => call.method === "sendPrompt")).toBe(
+        true
+      )
+    );
+    await bridge.emit({
+      type: "userInput.request",
+      request: {
+        requestId: "question-1",
+        sessionId: "session-1",
+        prompt: "Choose",
+        questions: [
+          {
+            question: "Which?",
+            header: "Choice",
+            options: [{ value: "native", label: "Displayed" }],
+          },
+        ],
+      },
+    });
+    const pending = session.getPendingPermissions()[0]!;
+    await session.respondToPermission(pending.id, {
+      behavior: "allow",
+      updatedInput: { answers: { Choice: "Displayed" } },
+    });
+    expect(
+      bridge.calls.find((call) => call.method === "respondStructuredInput")
+    ).toEqual({
+      method: "respondStructuredInput",
+      params: {
+        workspacePath: expect.any(String),
+        sessionId: "session-1",
+        requestId: "question-1",
+        response: {
+          action: "accept",
+          content: {
+            answer_0: "native",
+            answer: "native",
+            answers: { "Which?": ["native"] },
+          },
+        },
+      },
+    });
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e0",
+        sessionId: "session-1",
+        seq: 0,
+        timestamp: 2,
+        deliveryKind: "desktop-continuous",
+        type: "turn.completed",
+        payload: { resultType: "success" },
+      },
+    });
+    await run;
+  });
+
+  it("fails closed on unknown events", async () => {
+    const { bridge, session } = await fixture();
+    const run = session.run("unknown");
+    await vi.waitFor(() =>
+      expect(bridge.calls.some((call) => call.method === "sendPrompt")).toBe(
+        true
+      )
+    );
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e0",
+        sessionId: "session-1",
+        seq: 0,
+        timestamp: 1,
+        deliveryKind: "desktop-continuous",
+        type: "future.event",
+        payload: {},
+      },
+    });
+    await expect(run).rejects.toThrow(/Unsupported ZCode event/u);
+    expect(
+      bridge.calls.some((call) => call.method === "cancelGeneration")
+    ).toBe(true);
+  });
+
+  it("allows filtered sequence gaps but rejects duplicates", async () => {
+    const { bridge, session } = await fixture();
+    const run = session.run("sequence");
+    await vi.waitFor(() =>
+      expect(bridge.calls.some((call) => call.method === "sendPrompt")).toBe(
+        true
+      )
+    );
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e1",
+        sessionId: "session-1",
+        seq: 1,
+        timestamp: 1,
+        deliveryKind: "desktop-continuous",
+        type: "session.updated",
+        payload: {},
+      },
+    });
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e3",
+        sessionId: "session-1",
+        seq: 3,
+        timestamp: 2,
+        deliveryKind: "desktop-continuous",
+        type: "session.updated",
+        payload: {},
+      },
+    });
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "duplicate-e3",
+        sessionId: "session-1",
+        seq: 3,
+        timestamp: 3,
+        deliveryKind: "desktop-continuous",
+        type: "session.updated",
+        payload: {},
+      },
+    });
+    await expect(run).rejects.toThrow(/duplicated or out of order/u);
+    expect(
+      bridge.calls.some((call) => call.method === "cancelGeneration")
+    ).toBe(true);
+  });
+
+  it("sends cancel once and waits for the terminal event", async () => {
+    const { bridge, session } = await fixture();
+    const run = session.run("cancel");
+    await vi.waitFor(() =>
+      expect(bridge.calls.some((call) => call.method === "sendPrompt")).toBe(
+        true
+      )
+    );
+    const interrupted = session.interrupt();
+    await vi.waitFor(() =>
+      expect(
+        bridge.calls.filter((call) => call.method === "cancelGeneration")
+      ).toHaveLength(1)
+    );
+    void session.interrupt();
+    await bridge.emit({
+      type: "session.event",
+      event: {
+        eventId: "e0",
+        sessionId: "session-1",
+        seq: 0,
+        timestamp: 1,
+        deliveryKind: "desktop-continuous",
+        type: "turn.completed",
+        payload: { resultType: "cancelled" },
+      },
+    });
+    await interrupted;
+    await expect(run).resolves.toMatchObject({ canceled: true });
+    expect(
+      bridge.calls.filter((call) => call.method === "cancelGeneration")
+    ).toHaveLength(1);
+  });
+});
